{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATLAS",
  "version": "0.0.1",
  "identifier": "com.tyree.atlas",
  "build": {
    "beforeDevCommand": "npm run dev -w @atlas/web",
    "beforeBuildCommand": "npm run build -w @atlas/web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATLAS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
